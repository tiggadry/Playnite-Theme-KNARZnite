<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style TargetType="{x:Type GridViewGameOverview}">
    <Style.Resources>
      <TextBlock
        x:Key="DefaultLinkTextBlock"
        Style="{StaticResource BaseTextBlockStyle}"
        Text="{DynamicResource DefaultLinkIcon}"
        FontFamily="{DynamicResource FontIcoFont}" />
    </Style.Resources>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
          <ScrollViewer
            x:Name="PART_ScrollViewHost"
            Style="{DynamicResource DetailsScrollViewer}"
            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
              <Grid
                x:Name="TopGrid"
                MinHeight="300"
                HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid.ContextMenu>
                  <ContextMenu Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin, Path=IsInstalled}" IsOpen="{PluginSettings Plugin=ThemeExtras, Path=Menus.IsOpen, Mode=OneWayToSource, FallbackValue={StaticResource False}}">
                    <MenuItem
                      Visibility="{PluginStatus Plugin=ExtraMetadataLoader_705fdbca-e1fc-4004-b839-1d040b8b4429,
                                                Path=IsInstalled}"
                      ItemsSource="{PluginSettings Plugin=ThemeExtras,
                                                   Path=Menus.EMLGameMenuItems,
                                                   FallbackValue={x:Null}}"
                      Header="ExtraMetadataLoader" />
                    <MenuItem
                      Visibility="{PluginStatus Plugin=playnite-backgroundchanger-plugin,
                                                Path=IsInstalled}"
                      ItemsSource="{PluginSettings Plugin=ThemeExtras,
                                                   Path=Menus.BackgroundChangerGameMenuItems,
                                                   FallbackValue={x:Null}}"
                      Header="BackgroundChanger" />
                    <Separator />
                    <MenuItem Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.OpenGameAssetFolderCommand, FallbackValue={x:Null}}" Header="{DynamicResource LOCOpenMetadataFolder}" />
                  </ContextMenu>
                </Grid.ContextMenu>

                <Rectangle Fill="Transparent" />

                <!--
                  Share one radial fade across the native fallback and both plugin background hosts,
                  so the original game artwork cannot show through a plugin-rendered background.
                -->
                <Border
                  x:Name="OuterBorderImage"
                  HorizontalAlignment="Center" VerticalAlignment="Top">
                  <Border.OpacityMask>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="2" RadiusY="0.9">
                      <RadialGradientBrush.GradientStops>
                        <GradientStop Color="Black" Offset="0.3" />
                        <GradientStop Color="Transparent" Offset="1" />
                      </RadialGradientBrush.GradientStops>
                    </RadialGradientBrush>
                  </Border.OpacityMask>
                  <Grid>
                    <Grid Visibility="{Binding IsVisible, ElementName=BackgroundChanger_PluginBackgroundImage, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                      <FadeImage
                        x:Name="PART_ImageBackground"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Stretch="UniformToFill" />
                    </Grid>
                    <ContentControl
                      x:Name="ImageRotater_Background"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Visibility="{Binding BackgroundVisibility}"
                      Focusable="False" HorizontalContentAlignment="Stretch"
                      IsTabStop="False" VerticalContentAlignment="Stretch" />
                    <ContentControl
                      x:Name="BackgroundChanger_PluginBackgroundImage"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="{PluginSettings Plugin=BackgroundChanger,
                                                  Path=HasDataBackground,
                                                  FallbackValue={x:Static Visibility.Collapsed}}" />
                  </Grid>
                </Border>

                <!--
                  DuplicateHider selector host for GridViewGameOverview.
                  Visibility is tied to TopGrid hover to keep the UI clean when idle.
                  The plugin injects icon content and applies its configured selector style
                  (typically DuplicateHider_IconContentControlStyle1) defined in DerivedStyles/GridViewItemTemplate.xaml.
                  Style brushes/effects are resolved from Constants(.red).xaml resources.
                -->
                <Grid
                  Height="50"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=TopGrid, Path=IsMouseOver}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>

                  <ContentControl x:Name="DuplicateHider_SourceSelector" Margin="10" />
                </Grid>
              </Grid>

              <Grid Margin="20,0,20,0" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                  <RowDefinition Height="{Settings CalculatedGameDetailsIndentation}" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1" MaxWidth="{DynamicResource DetailsViewDetailsMaxWidth}">
                  <!--#region Logo & Cover Image-->
                  <Border
                    x:Name="ExtraMetadataLoader_LogoLoaderControlGrid"
                    MinHeight="{PluginSettings Plugin=ExtraMetadataLoader,
                                               Path=LogoMaxHeight,
                                               FallbackValue=0}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Tag="{DynamicResource DetailsViewAllowUseOfLogos}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="False" />
                              <Condition Binding="{PluginSettings Plugin=ImageRotater, Path=HasDataLogo, FallbackValue=False}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                          </MultiDataTrigger>
                          <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid
                      x:Name="LogoGrid"
                      Width="{PluginSettings Plugin=ExtraMetadataLoader,
                                             Path=LogoMaxWidth,
                                             FallbackValue=600}"
                      Height="{PluginSettings Plugin=ExtraMetadataLoader,
                                              Path=LogoMaxHeight,
                                              FallbackValue=200}"
                      Margin="0,30,0,70"
                      HorizontalAlignment="{PluginSettings Plugin=ExtraMetadataLoader,
                                                           Path=LogoHorizontalAlignment,
                                                           FallbackValue=Center}"
                      VerticalAlignment="{PluginSettings Plugin=ExtraMetadataLoader,
                                                         Path=LogoVerticalAlignment,
                                                         FallbackValue=Center}">
                      <ContentControl
                        x:Name="ImageRotater_Logo"
                        MaxWidth="{PluginSettings Plugin=ExtraMetadataLoader,
                                                  Path=LogoMaxWidth,
                                                  FallbackValue=600}"
                        MaxHeight="{PluginSettings Plugin=ExtraMetadataLoader,
                                                   Path=LogoMaxHeight,
                                                   FallbackValue=200}"
                        HorizontalAlignment="{PluginSettings Plugin=ExtraMetadataLoader,
                                                             Path=LogoHorizontalAlignment,
                                                             FallbackValue=Center}"
                        VerticalAlignment="{PluginSettings Plugin=ExtraMetadataLoader,
                                                           Path=LogoVerticalAlignment,
                                                           FallbackValue=Center}">
                        <ContentControl.Style>
                          <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{PluginSettings Plugin=ImageRotater, Path=HasDataLogo, FallbackValue=False}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ContentControl.Style>
                      </ContentControl>
                      <ContentControl
                        x:Name="ExtraMetadataLoader_LogoLoaderControl"
                        MaxWidth="{PluginSettings Plugin=ExtraMetadataLoader,
                                                  Path=LogoMaxWidth,
                                                  FallbackValue=600}"
                        MaxHeight="{PluginSettings Plugin=ExtraMetadataLoader,
                                                   Path=LogoMaxHeight,
                                                   FallbackValue=200}"
                        HorizontalAlignment="{PluginSettings Plugin=ExtraMetadataLoader,
                                                             Path=LogoHorizontalAlignment,
                                                             FallbackValue=Center}"
                        VerticalAlignment="{PluginSettings Plugin=ExtraMetadataLoader,
                                                           Path=LogoVerticalAlignment,
                                                           FallbackValue=Center}">
                        <ContentControl.Style>
                          <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{PluginSettings Plugin=ImageRotater, Path=HasDataLogo, FallbackValue=False}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ContentControl.Style>
                      </ContentControl>
                    </Grid>
                  </Border>

                  <DockPanel
                    x:Name="TitleIconPanel"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Image
                      DockPanel.Dock="Left"
                      MaxWidth="48" MaxHeight="48"
                      Margin="0,0,10,0" VerticalAlignment="Center"
                      Name="PART_ImageIcon" RenderOptions.BitmapScalingMode="Fant" />
                    <TextBlock
                      DockPanel.Dock="Left"
                      Margin="0,0,10,0" VerticalAlignment="Center"
                      Tag="{DynamicResource DetailsViewHideGameNameIfLogoVisible}"
                      FontFamily="{DynamicResource FontFamily}"
                      FontSize="{DynamicResource FontSizeLargest}"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource TextBrush}"
                      Name="PART_TextDisplayName" TextWrapping="Wrap">
                      <TextBlock.Effect>
                        <DropShadowEffect RenderingBias="Quality" ShadowDepth="2" />
                      </TextBlock.Effect>
                    </TextBlock>
                  </DockPanel>

                  <DockPanel
                    x:Name="CoverDockPanel"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Visibility="{Binding CoverVisibility}"
                    Effect="{DynamicResource DefaultDropShadow}">
                    <ContentControl
                      x:Name="ThemeExtras_Banner"
                      DockPanel.Dock="Top"
                      Width="{Binding ActualWidth, ElementName=PART_ImageCover}"
                      Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Tag="{DynamicResource DetailsViewCoverDisplayLibraryBanner}"
                      RenderOptions.BitmapScalingMode="Fant" />
                    <!--  The named plugin hosts layer artwork over the native cover for their respective addons.  -->
                    <Grid x:Name="CoverGrid" DockPanel.Dock="Top">
                      <Image
                        Height="{Settings GameDetailsCoverHeight}"
                        Visibility="{Binding IsVisible, ElementName=BackgroundChanger_PluginBackgroundImage, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                        Name="PART_ImageCover" RenderOptions.BitmapScalingMode="Fant"
                        Stretch="Uniform" StretchDirection="Both" />
                      <ContentControl
                        x:Name="BackgroundChanger_PluginCoverImage"
                        DockPanel.Dock="Right"
                        Height="{Settings GameDetailsCoverHeight}"
                        VerticalAlignment="Bottom"
                        Visibility="{PluginSettings Plugin=BackgroundChanger,
                                                    Path=HasDataCover,
                                                    FallbackValue={x:Static Visibility.Collapsed},
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                        RenderOptions.BitmapScalingMode="Fant" />
                      <ContentControl
                        x:Name="ImageRotater_Cover"
                        Height="{Settings GameDetailsCoverHeight}"
                        Tag="ImageRotater:Stretch=Uniform;StretchDirection=Both"
                        RenderOptions.BitmapScalingMode="Fant" />
                    </Grid>
                  </DockPanel>
                  <!--#regionend-->
                </Grid>
                <DockPanel
                  x:Name="ButtonBar"
                  Grid.Row="2"
                  MaxWidth="{DynamicResource DetailsViewDetailsMaxWidth}"
                  Margin="0,20,0,15"
                  Tag="{DynamicResource LinkBarAsBox}"
                  Background="Transparent">
                  <StackPanel DockPanel.Dock="Left" VerticalAlignment="Bottom">
                    <WrapPanel Margin="0,15,0,0" Orientation="Horizontal">
                      <Button
                        x:Name="ButtonPlayAction"
                        Style="{DynamicResource PlayButton}"
                        VerticalAlignment="Center"
                        Command="{Binding ContextActionCommand}"
                        ToolTip="{Binding ContextActionDescription}" />
                      <Button
                        x:Name="ButtonInstallAction"
                        Style="{DynamicResource InstallButton}"
                        VerticalAlignment="Center"
                        Command="{Binding ContextActionCommand}"
                        ToolTip="{Binding ContextActionDescription}"
                        Tag="{DynamicResource HidePlayButtonForManualGames}" />
                      <Button
                        x:Name="ButtonContextAction"
                        Style="{DynamicResource ContextActionButton}"
                        VerticalAlignment="Center"
                        Command="{Binding ContextActionCommand}"
                        ToolTip="{Binding ContextActionDescription}" />
                      <Button
                        x:Name="PART_ButtonEditGame"
                        Width="40" Height="40"
                        Margin="0,0,10,0" VerticalAlignment="Center"
                        Content="&#xEDED;"
                        FontFamily="{DynamicResource FontIcoFont}" />
                      <Button
                        x:Name="PART_ButtonMoreActions"
                        Width="40" Height="40"
                        Margin="0,0,10,0" VerticalAlignment="Center"
                        Content="&#xEFA2;"
                        FontFamily="{DynamicResource FontIcoFont}" />

                      <Border
                        x:Name="PlayTimeButton"
                        Style="{StaticResource BorderBlock}"
                        Height="40"
                        Margin="0,0,10,0" Padding="8,0"
                        Tag="{DynamicResource ShowPlayTimeInButtonBar}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                          <TextBlock
                            Style="{DynamicResource BaseTextBlockStyle}"
                            Margin="0,0,10,0" VerticalAlignment="Center"
                            Text="&#xEEDC;"
                            FontFamily="{StaticResource FontIcoFont}"
                            FontSize="24"
                            Foreground="{DynamicResource GlyphBrush}" />
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock
                              Style="{DynamicResource BaseTextBlockStyle}"
                              Text="{DynamicResource LOCTimePlayed}"
                              FontSize="{DynamicResource FontSizeSmall}" />
                            <TextBlock
                              Style="{DynamicResource BaseTextBlockStyle}"
                              Text="{Binding Game.Playtime, Converter={StaticResource PlayTimeToStringConverter}}"
                              FontSize="{DynamicResource FontSizeSmall}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <ContentControl
                        x:Name="ScreenshotUtilities_ButtonControl"
                        Style="{DynamicResource ActionControl}"
                        Visibility="{PluginSettings Plugin=ScreenshotUtilities,
                                                    Path=IsButtonControlVisible,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ContentControl
                        x:Name="PlayState_GameStateSwitchControl"
                        Style="{DynamicResource ActionControl}"
                        Visibility="{PluginSettings Plugin=PlayState,
                                                    Path=IsControlVisible,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ContentControl
                        x:Name="ScreenshotsVisualizer_PluginButton"
                        Style="{DynamicResource ActionControl}"
                        Visibility="{PluginSettings Plugin=ScreenshotsVisualizer,
                                                    Path=HasData,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ContentControl
                        x:Name="HowLongToBeat_PluginButton"
                        Style="{DynamicResource ActionControl}"
                        Visibility="{PluginSettings Plugin=HowLongToBeat,
                                                    Path=EnableIntegrationButton,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />

                      <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel.Style>
                          <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{PluginSettings Plugin=HowLongToBeat, Path=HasData, FallbackValue=False}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <ContentControl
                          x:Name="HowLongToBeat_PluginProgressBar"
                          Width="250" Height="40" />
                      </StackPanel>

                      <ContentControl
                        x:Name="CheckDlc_PluginButton"
                        Style="{DynamicResource ActionControl}"
                        Visibility="{PluginSettings Plugin=CheckDlc,
                                                    Path=EnableIntegrationButton,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ContentControl
                        x:Name="PlayniteAchievements_AchievementButton"
                        Style="{DynamicResource ActionControl}"
                        Visibility="{PluginSettings Plugin=PlayniteAchievements,
                                                    Path=HasData,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ContentControl
                        x:Name="GameActivity_PluginButton"
                        Style="{DynamicResource ActionControl}"
                        Visibility="{PluginSettings Plugin=GameActivity,
                                                    Path=HasData,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ContentControl
                        x:Name="SystemChecker_PluginButton"
                        Style="{DynamicResource ActionControl}"
                        Visibility="{PluginSettings Plugin=SystemChecker,
                                                    Path=EnableIntegrationButton,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ContentControl
                        x:Name="CheckLocalizations_PluginButton"
                        Style="{DynamicResource ActionControl}"
                        Visibility="{PluginSettings Plugin=CheckLocalizations,
                                                    Path=EnableIntegrationButton,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ContentControl x:Name="NewsViewer_PlayersInGameViewerControl">
                        <ContentControl.Resources>
                          <Style BasedOn="{StaticResource PlayersCountButtonStyle}" TargetType="Button" />
                        </ContentControl.Resources>
                      </ContentControl>

                      <ContentControl
                        x:Name="LibraryManagement_PluginFeaturesIconList"
                        Height="35"
                        VerticalAlignment="Center"
                        Visibility="{PluginSettings Plugin=LibraryManagement,
                                                    Path=EnableIntegrationFeatures,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                        Opacity="0.85" />

                      <ContentControl
                        x:Name="GogSecondClassWatcher_SecondClassWatcherControl"
                        Margin="5,0,0,0" VerticalAlignment="Center"
                        Visibility="{PluginSettings Plugin=GogSecondClassWatcher,
                                                    Path=IsControlVisible,
                                                    FallbackValue=Collapsed,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>

                    <Border
                      x:Name="LinkBar"
                      Margin="0,20,0,0" Padding="5"
                      Tag="{DynamicResource DisplayLinkBar}"
                      Background="{DynamicResource OpaqueButtonBackgroundBrush}"
                      BorderBrush="{DynamicResource NormalBorderBrush}"
                      BorderThickness="{StaticResource ControlBorderThickness}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Effect="{DynamicResource DefaultSubtleDropShadow}">
                      <Border.Style>
                        <Style TargetType="{x:Type Border}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=True}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <DockPanel>
                        <TextBlock
                          Margin="10,5,20,5" VerticalAlignment="Center"
                          Text="&#xef71;"
                          FontFamily="{StaticResource FontIcoFont}"
                          FontSize="40"
                          Foreground="{DynamicResource GlyphBrush}" />
                        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Game.Links}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel VerticalAlignment="Center" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type Link}">
                              <TextBlock
                                DockPanel.Dock="Left"
                                Margin="0,4,10,4"
                                Typography.Capitals="AllSmallCaps">
                                <Hyperlink Command="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=DataContext.OpenLinkCommand}" CommandParameter="{Binding}">
                                  <Run Text="{Binding Name}" />
                                </Hyperlink>
                              </TextBlock>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </DockPanel>

                <DockPanel
                  x:Name="DetailsSection"
                  Grid.Row="3"
                  MaxWidth="{DynamicResource DetailsViewDetailsMaxWidth}"
                  Tag="{DynamicResource DisableDetailsSection}">
                  <StackPanel
                    DockPanel.Dock="Left"
                    Width="300"
                    Margin="0,0,10,0">
                    <StackPanel.Resources>
                      <Style TargetType="ItemsControl">
                        <Setter Property="VerticalAlignment" Value="Center" />
                      </Style>
                      <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
                        <Setter Property="Margin" Value="0,4,8,4" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                      </Style>
                      <Style BasedOn="{StaticResource PropertyItemButton}" TargetType="Button">
                        <Setter Property="VerticalAlignment" Value="Center" />
                      </Style>
                    </StackPanel.Resources>

                    <TextBlock
                      Style="{DynamicResource BaseTextBlockStyle}"
                      Margin="5,14,5,2"
                      Text="{DynamicResource LOCGameDetails}"
                      FontSize="{DynamicResource FontSizeLarger}"
                      FontWeight="Bold"
                      Foreground="{DynamicResource TextBrushDarker}"
                      Typography.Capitals="AllSmallCaps" />

                    <Separator Background="{DynamicResource WindowPanelSeparatorBrush}" />

                    <Grid Margin="0,10,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Grid.Resources>
                        <Style BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
                          <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style
                          x:Key="Icon"
                          BasedOn="{StaticResource BaseTextBlockStyle}"
                          TargetType="TextBlock">
                          <Setter Property="Width" Value="24" />
                          <Setter Property="FontFamily" Value="{StaticResource FontIcoFont}" />
                          <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Style>
                        <Style
                          x:Key="KNARZIcon"
                          BasedOn="{StaticResource BaseTextBlockStyle}"
                          TargetType="TextBlock">
                          <Setter Property="Width" Value="24" />
                          <Setter Property="FontFamily" Value="{DynamicResource KNARZfont}" />
                          <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Style>
                        <Style TargetType="Label">
                          <Setter Property="FontWeight" Value="Normal" />
                          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                          <Setter Property="Margin" Value="0,0,0,0" />
                        </Style>
                      </Grid.Resources>

                      <Label Name="PART_ElemCompletionStatus">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Style="{DynamicResource Icon}" Text="&#xEED6;" />
                          <TextBlock Text="{DynamicResource LOCCompletionStatus}" />
                        </StackPanel>
                      </Label>
                      <Grid
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Visibility="{Binding CompletionStatusVisibility}">
                        <Grid VerticalAlignment="Center" Tag="{DynamicResource DisplayCompletionStatusComboBox}">
                          <Grid.Style>
                            <Style TargetType="Grid">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}" Value="true">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Grid.Style>

                          <Button VerticalAlignment="Center" Name="PART_ButtonCompletionStatus" />
                        </Grid>
                        <Grid HorizontalAlignment="Stretch" Tag="{DynamicResource DisplayCompletionStatusComboBox}">
                          <Grid.Style>
                            <Style TargetType="Grid">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}" Value="true">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Grid.Style>

                          <ContentControl
                            x:Name="ThemeExtras_SettableCompletionStatus"
                            HorizontalAlignment="Stretch"
                            Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin,
                                                      Status=Installed}">
                            <ContentControl.Resources>
                              <Style TargetType="UserControl">
                                <Setter Property="Content">
                                  <Setter.Value>
                                    <ComboBox ItemsSource="{Binding CompletionStatusOptions}" SelectedItem="{Binding Value}">
                                      <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type CompletionStatus}">
                                          <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                      </ComboBox.ItemTemplate>
                                    </ComboBox>
                                  </Setter.Value>
                                </Setter>
                              </Style>
                            </ContentControl.Resources>
                          </ContentControl>
                        </Grid>
                      </Grid>

                      <Label Grid.Row="1" Name="PART_ElemPlayTime">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Style="{DynamicResource Icon}" Text="&#xEEDC;" />
                          <TextBlock Text="{DynamicResource LOCTimePlayed}" />
                        </StackPanel>
                      </Label>
                      <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Name="PART_TextPlayTime" />

                      <Label Grid.Row="2" Name="PART_ElemLastPlayed">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Style="{DynamicResource Icon}" Text="&#xEC45;" />
                          <TextBlock Text="{DynamicResource LOCLastPlayed}" />
                        </StackPanel>
                      </Label>
                      <TextBlock
                        Grid.Row="2" Grid.Column="1"
                        Name="PART_TextLastActivity" />

                      <Label Grid.Row="3" Name="PART_ElemRecentActivity">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Style="{DynamicResource Icon}" Text="&#xEC45;" />
                          <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" />
                        </StackPanel>
                      </Label>
                      <TextBlock
                        Grid.Row="3" Grid.Column="1"
                        Name="PART_TextRecentActivity" />

                      <Label Grid.Row="4" Name="PART_ElemAdded">
